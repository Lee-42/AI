{
  "name": "@voice/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "contract:export": "tsx src/export-openapi.ts",
    "dev": "tsx watch src/server.ts",
    "index:knowledge:cloud": "tsx src/knowledge/index-knowledge-in-chroma.ts",
    "inspect:knowledge-ingestion": "tsx src/knowledge/inspect-knowledge-ingestion.ts",
    "inspect:knowledge-index": "tsx src/knowledge/inspect-knowledge-index.ts",
    "inspect:knowledge-retrieval": "tsx src/knowledge/inspect-knowledge-retrieval.ts",
    "inspect:realtime-rag-policy": "tsx src/ai/inspect-realtime-conversation-policy.ts",
    "inspect:realtime-rag-service": "tsx src/ai/inspect-realtime-rag-service.ts",
    "start": "node --enable-source-maps dist/server.js",
    "test": "vitest run",
    "test:ai-orchestrator": "vitest run test/ai-orchestrator.test.ts",
    "test:ai-provider": "vitest run test/volcengine-ark-language-model.test.ts test/ai-debug-api.test.ts test/config.test.ts",
    "test:ai-stream": "vitest run test/ai-turn-stream-service.test.ts test/sse-event-writer.test.ts test/ai-debug-api.test.ts",
    "test:contract": "vitest run test/contract-conformance.test.ts",
    "test:e2e": "vitest run test/voice-journey.e2e.test.ts",
    "test:fault": "vitest run test/fault-injection.test.ts",
    "test:knowledge-governance": "vitest run test/knowledge-source-governance.test.ts",
    "test:knowledge-ingestion": "vitest run test/knowledge-ingestion-pipeline.test.ts",
    "test:knowledge-index": "vitest run test/knowledge-vector-index.test.ts test/volcengine-text-embedding-provider.test.ts test/config.test.ts",
    "test:knowledge-retrieval": "vitest run test/knowledge-hybrid-search.test.ts test/knowledge-evidence-pipeline.test.ts",
    "test:rag-baseline": "vitest run test/rag-product-baseline.test.ts",
    "test:realtime-rag-policy": "vitest run test/realtime-conversation-policy.test.ts test/conversation-memory.test.ts test/safe-fallback-policy.test.ts",
    "test:realtime-rag-service": "vitest run test/realtime-rag-service.test.ts test/realtime-conversation-policy.test.ts test/conversation-memory.test.ts test/safe-fallback-policy.test.ts test/mock-voice-agent-provider.test.ts test/ai-debug-api.test.ts test/ai-turn-stream-service.test.ts test/session-closure-service.test.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@voice/contracts": "workspace:*",
    "chromadb": "^3.5.0",
    "fastify": "^5.10.0",
    "typebox": "^1.3.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
