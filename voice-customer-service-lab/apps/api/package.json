{
  "name": "@voice/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "contract:export": "tsx src/export-openapi.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@voice/contracts": "workspace:*",
    "fastify": "^5.10.0",
    "typebox": "^1.3.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
