# Copy this file to .env for local API development.
# Keep every value here fake or empty. Never commit a real credential.

# Runtime
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VOICE_PROVIDER=mock
# Token signing is independent from starting the paid AI voice provider.
RTC_TOKEN_PROVIDER=mock

# Session safety limits
SESSION_TTL_SECONDS=1200
MAX_SESSION_SECONDS=900
# Structured summaries only; raw audio and transcript retention stay disabled.
SESSION_SUMMARY_RETENTION_DAYS=7
AGENT_REAPER_INTERVAL_SECONDS=15
# Local rolling SLO window; production dashboards should use a durable 28-day window.
OBSERVABILITY_WINDOW_SECONDS=3600

# Versioned, non-secret business policy. The server validates and compiles this file.
CUSTOMER_SERVICE_POLICY_PATH=config/customer-service-policy.v1.json

# Independent LLM/RAG path. This does not change the managed Voice Agent provider above.
RAG_ANSWER_POLICY_PATH=config/rag-answer-policy.v1.json
LLM_PROVIDER=mock
# Local/test-only endpoint for typed text debugging. It is not a production public chat API.
LLM_DEBUG_API_ENABLED=false
# Selecting a real provider is not enough; paid model calls need this second explicit switch.
LLM_PAID_CALLS_ENABLED=false
LLM_REQUEST_TIMEOUT_MS=15000

# Server-only Volcengine Ark Chat Completions configuration.
# Keep the official v3 base URL; the server rejects arbitrary hosts to prevent API Key exfiltration.
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ARK_MODEL=
VOLCENGINE_ARK_API_KEY=

# Volcengine server-side configuration.
# The current AI audio/video API is pinned; do not copy an old tutorial version.
VOLCENGINE_VOICE_API_VERSION=2025-06-01

# Keep false until billing alerts and a supervised cloud test are ready.
# Credentials alone must never enable a paid path.
VOLCENGINE_PAID_CALLS_ENABLED=false

# Keep false for local study. Real Function Calling needs this API on a public HTTPS URL.
VOLCENGINE_FUNCTION_CALLING_ENABLED=false
VOLCENGINE_FUNCTION_CALLBACK_URL=

# Export/copy the console's current StartVoiceChat Config object into this ignored file.
VOLCENGINE_VOICE_CONFIG_PATH=config/voice-agent.local.json
# The cloud default is longer; this lab uses 30 seconds to limit idle billing.
VOLCENGINE_AGENT_IDLE_TIMEOUT_SECONDS=30

# AppId/AppKey are required when RTC_TOKEN_PROVIDER=volcengine.
# All four credentials are required later when VOICE_PROVIDER=volcengine.
# Use the AppId from "AI 音视频互动方案", not the legacy conversational AI product.
VOLCENGINE_RTC_APP_ID=
VOLCENGINE_RTC_APP_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
# Shared Function Calling callback value; this is a server-only secret, not a browser Token.
VOLCENGINE_CALLBACK_SIGNING_SECRET=

# Observability credentials also belong to the server process.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
