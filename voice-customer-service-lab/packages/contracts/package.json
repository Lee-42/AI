{
  "name": "@voice/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.generated.d.ts",
      "import": "./dist/api.generated.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript openapi/voice-api.v1.json -o src/api.generated.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
