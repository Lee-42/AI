# Optional. Set to openai or deepseek. Leave empty to auto-select by configured key.
LLM_PROVIDER=

# OpenAI settings.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_ADVANCED_MODEL=gpt-4o

# DeepSeek settings. DeepSeek is used through LangChain's OpenAI-compatible client.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ADVANCED_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Enable LangSmith tracing if you have a LangSmith API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
