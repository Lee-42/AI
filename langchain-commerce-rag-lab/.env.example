# Chroma: use "local" with CHROMA_URL or "cloud" with the cloud fields.
CHROMA_MODE=local
CHROMA_URL=http://localhost:8000
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_HOST=

# Volcengine Ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Accepts a text embedding Model ID or an embedding Endpoint ID.
ARK_TEXT_EMBEDDING_MODEL=
# Current Doubao-embedding-vision models use the multimodal API.
ARK_TEXT_EMBEDDING_API_MODE=multimodal
ARK_MULTIMODAL_EMBEDDING_MODEL=

# OpenAI-compatible chat model used by the final RAG step
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=

# LangSmith tracing is opt-in. Keep secrets only in .env, never here.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=langsmith-volcengine-lab
# Personal API keys for one workspace normally leave this empty.
LANGSMITH_WORKSPACE_ID=
# Short-lived examples wait until the trace upload is complete.
LANGSMITH_TRACING_BACKGROUND=false
