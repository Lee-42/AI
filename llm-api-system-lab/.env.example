# Copy this file to .env and fill in the keys you need.

# Optional: openai or deepseek. If omitted, the app chooses a configured key.
LLM_PROVIDER=deepseek

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# OpenAI-compatible provider example.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# DeepSeek official API docs currently do not list a vision/image input model.
# Keep this unset unless your provider/account exposes a vision-capable DeepSeek-compatible model.
DEEPSEEK_VISION_MODEL=your_deepseek_vision_model
# 用于 src/examples/08-deepseek-cot-stream.ts
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high

# Optional. Used by src/examples/13-deepseek-web-search.ts and 14-deepseek-thinking-web-search.ts.
# If omitted, the example falls back to DuckDuckGo HTML search for teaching/demo use.
TAVILY_API_KEY=your_tavily_api_key

# Used by src/examples/04-vision-url.ts
IMAGE_URL=https://wownow-micro-admin-prod.iwownow.com/platform/device-task/2026/05/22/a120eb6d-1599-48bf-a698-0ceed664eb88.png

# Optional. Used by src/examples/15-deepseek-image-tool-count-strawberries.ts.
# If omitted, the example uses a public Wikimedia strawberry image.
STRAWBERRY_IMAGE_URL=https://upload.wikimedia.org/wikipedia/commons/2/29/PerfectStrawberry.jpg

# Used by src/examples/11-vision-file.ts
IMAGE_PATH=./assets/example.png
